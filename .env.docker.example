# Apenas para desenvolvimento local com Docker. Troque os valores antes de usar.
POSTGRES_DB=guardiao
POSTGRES_USER=guardiao
POSTGRES_PASSWORD=guardiao_local_only_change_me

# Mantenha usuário, senha e banco sincronizados com os valores acima.
DATABASE_URL=postgresql://guardiao:guardiao_local_only_change_me@db:5432/guardiao

# Chave local de exemplo. Gere outra com o comando indicado no README.
CODIGO_SEGREDO=local-only-example-key-replace-with-a-random-secret-at-least-32-chars
APP_PORT=3000
