# Copie este arquivo para .env e preencha. O .env nunca vai para o Git (RNF16).

# Connection string do Neon (painel do projeto > Connect).
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/banco?sslmode=require

# Chave do hash dos códigos de acompanhamento, com pelo menos 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Depois que houver denúncias, NÃO troque: os códigos já entregues deixam de funcionar.
CODIGO_SEGREDO=

PORT=3000

# Em produção, use production: todo pedido HTTP vai para HTTPS e o cookie de login só trafega por HTTPS.
# Exige o HTTPS da hospedagem na frente do Node (veja "Produção e HTTPS" no README).
NODE_ENV=development
